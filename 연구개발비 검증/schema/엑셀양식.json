{
  "_설명": "검토 결과를 엑셀로 내보낼 때의 시트·열 정의. 코드가 이 파일을 읽어 엑셀을 만든다.",
  "_양식버전": "0.1",
  "파일명": "연구비검토_{사업명}_{YYYYMMDD}.xlsx",

  "공통서식": {
    "글꼴": "맑은 고딕",
    "머리행": { "굵게": true, "배경색": "#D9E1F2", "고정": true },
    "금액서식": "#,##0",
    "비율서식": "0.0\"%\"",
    "판정색": {
      "적정":     { "배경색": "#C6EFCE", "글자색": "#006100" },
      "확인 필요": { "배경색": "#FFEB9C", "글자색": "#9C5700" },
      "부적정":   { "배경색": "#FFC7CE", "글자색": "#9C0006" }
    }
  },

  "시트": [
    {
      "이름": "요약",
      "행단위": "기관 1개 = 1행",
      "열": [
        { "제목": "기관명",       "값": "기관.기관명" },
        { "제목": "역할",         "값": "기관.역할" },
        { "제목": "기관유형",     "값": "기관.기관유형" },
        { "제목": "총연구개발비", "값": "총연구개발비", "서식": "금액" },
        { "제목": "적정",         "값": "COUNT(판정 == '적정')" },
        { "제목": "확인 필요",    "값": "COUNT(판정 == '확인 필요')" },
        { "제목": "부적정",       "값": "COUNT(판정 == '부적정')" },
        { "제목": "종합판정",     "값": "부적정 >= 1 → 부적정, 확인 필요 >= 1 → 확인 필요, 그 외 적정", "서식": "판정색" }
      ],
      "마지막행": { "제목": "합계", "수식열": ["총연구개발비", "적정", "확인 필요", "부적정"] }
    },
    {
      "이름": "상세",
      "행단위": "기관 × 검사 1개 = 1행",
      "열": [
        { "제목": "기관명",     "값": "기관.기관명" },
        { "제목": "항목",       "값": "규칙.항목" },
        { "제목": "검사내용",   "값": "검사.설명" },
        { "제목": "신청액",     "값": "비교값", "서식": "금액" },
        { "제목": "기준산정액", "값": "계산값", "서식": "금액" },
        { "제목": "차이",       "값": "=신청액-기준산정액", "서식": "금액", "_비고": "엑셀 수식으로 입력" },
        { "제목": "판정",       "값": "판정", "서식": "판정색" },
        { "제목": "근거조항",   "값": "검사.근거" },
        { "제목": "의견",       "값": "Claude 해설 (2~3문장)" }
      ],
      "정렬": ["기관명", "판정(부적정 → 확인 필요 → 적정)"]
    },
    {
      "이름": "통합검증",
      "표시조건": "같은 과제 선택 그리고 파일 2개 이상",
      "열": [
        { "제목": "검사내용", "값": "검사.설명" },
        { "제목": "관련기관", "값": "해당 기관명 목록" },
        { "제목": "계산값",   "값": "계산값", "서식": "금액" },
        { "제목": "비교값",   "값": "비교값", "서식": "금액" },
        { "제목": "판정",     "값": "판정", "서식": "판정색" },
        { "제목": "의견",     "값": "Claude 해설" }
      ]
    },
    {
      "이름": "처리기록",
      "열": [
        { "제목": "파일명",        "값": "파일정보.파일명" },
        { "제목": "처리일시",      "값": "처리 시각 (YYYY-MM-DD HH:MM)" },
        { "제목": "처리결과",      "값": "성공 / 처리 실패" },
        { "제목": "실패사유",      "값": "오류 메시지" },
        { "제목": "적용규칙기준일", "값": "rules/*.json의 기준일" },
        { "제목": "추출메모",      "값": "추출메모 (줄바꿈으로 연결)" }
      ]
    }
  ],

  "하단문구": "본 결과는 참고용 사전 검토이며, 최종 판단은 전문기관 기준에 따릅니다.",
  "개인정보": "연구원 성명은 '상세'·'통합검증' 시트에서만 표시하고, 연봉은 엑셀에 넣지 않는다."
}
